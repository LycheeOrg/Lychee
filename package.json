		"@vueuse/components": "^15.0.0",
		"@vueuse/core": "^15.0.0",
		"axios": "^1.20.0",
		"axios-cache-interceptor": "^1.12.3",
		"echarts": "^6.1.0",
		"image-focus": "^1.2.1",
		"justified-layout": "^4.1.0",
