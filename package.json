		"@lychee-org/layouts": "^0.1.0",
		"@lychee-org/nested-set-checker-wasm": "^2.0.0",
		"@lychee-org/zxcvbn-wasm": "^1.0.1",
		"@mollie/api-client": "^4.6.0",
