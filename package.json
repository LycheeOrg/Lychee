{
	"name": "lychee",
	"private": true,
	"type": "module",
	"scripts": {
		"pretypecheck": "bash scripts/generate-js-types.sh",
		"typecheck": "vue-tsc --noEmit -p tsconfig.json --composite false --skipLibCheck",
		"dev": "vp dev",
		"build": "vp build && vp build --config vite.embed.config.ts",
