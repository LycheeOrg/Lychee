<?php

/**
 * Stub for the `memprof` PECL extension (arnaud-lb/php-memory-profiler),
 * which is not a Composer dependency and is not installed on the analysis
 * machine (it is an optional, manually-installed opt-in extension — see
 * Feature 053 and docs/specs/2-how-to/enable-memory-profiler.md).
 *
 * Every call site guards these functions behind `function_exists()` via
 * App\Services\Profiling\MemprofRecorder; this stub exists only so PHPStan
 * can type-check those call sites instead of reporting "function not found".
 *
 * Signatures taken from the upstream `memprof.stub.php`.
 */

